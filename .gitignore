# ---------------------------------------------------------------
# Everything personal is generated by the onboarding skill and
# must never be committed. If you fork this repo, keep this file.
# ---------------------------------------------------------------

# Identity + memory (generated from setup/templates/)
/USER.md
/IDENTITY.md
/MEMORY.md
/DREAMS.md
/memory/*
!/memory/.gitkeep

# Personal context
/context-library/personal/*
!/context-library/personal/.gitkeep
/context-library/shared/*
!/context-library/shared/.gitkeep

# Anything the agent produces
/outputs/**
!/outputs/daily-plans/
!/outputs/daily-plans/.gitkeep
/media/

# Rendered automations (contain chat IDs and account names)
/automations/cron-jobs.json
/automations/launchd/*.plist

# Secrets and credentials
.env
.env.*
!.env.example
credentials*.json
client_secret*.json
token*.json
*.pem
*.key
*.p12

# Framework internals, backups, local state
.openclaw/
.clawhub/
.openclaw-cli-images/
*.tar.gz
*.zip
*.sqlite*
*.bak
*.migrated*
.claude/settings.local.json

# OS noise
.DS_Store
